  <footer>
    <img class="footer-logo" src="assets/logo/aioli-logo.png" alt="Aïoli Bistrô">
    <p>Sabores &amp; Experiências · Campo Grande, MS</p>
    <a href="#top">Voltar ao topo ↑</a>
